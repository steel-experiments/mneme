# Mneme basic install settings.
# Copy to .env and fill in. No real secret belongs in this file or in YAML.
# Every supported setting, with its default, is listed in
# config/advanced.env.example — copy single lines from there when needed.

# ---- Chat platform (required) ----
# One platform for each deployment. The only supported value is discord.
MNEME_PLATFORM=discord

# ---- Discord (required) ----
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# API credential for the selected provider. LLM_PROVIDER and LLM_MODEL default
# to openai and gpt-5.6-terra when unset. For another provider set LLM_PROVIDER
# and use its key instead:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
OPENAI_API_KEY=

# ---- Organization ----
ORG_NAME=Your Company
ORG_TIMEZONE=UTC
# Comma-separated Discord role snowflakes. Leave empty to deny all admin
# operations; the app logs a startup warning when it is empty.
MNEME_ADMIN_ROLE_IDS=

# ---- Channel selection (basic mode) ----
# basic builds the channel policy from the two lists below. file loads
# CHANNEL_POLICY_PATH instead; in basic mode that path is not read.
# Changes in either mode take effect after a restart.
CHANNEL_POLICY_SOURCE=basic
# Comma-separated channel or category ids to ingest as org-visible. Each
# snowflake names exactly one resource kind. At least one id must be present
# across the two lists; both empty is a startup error.
ORG_VISIBLE_CHANNEL_IDS=
# Comma-separated channel or category ids to ingest as restricted.
RESTRICTED_CHANNEL_IDS=
MNEME_REVIEW_CHANNEL_ID=
# Set to true only after the review channel audience was verified. When true,
# the id above must be set as well.
MNEME_REVIEW_CHANNEL_SECURE=false

# ---- Initial import scope (explicit choice) ----
# FULL_HISTORY must be set explicitly. Choose the initial import scope:
# true  = import all reachable history for the selected channels;
# false = new messages onward (not a hard boundary; some sync paths may
#         still touch older rows).
FULL_HISTORY=

# ---- Spend ----
# Daily admission control for all LLM spend. This is not a provider billing
# ceiling; the hosting bill is separate. "unlimited" removes the cap.
LLM_DAILY_BUDGET_USD=2
