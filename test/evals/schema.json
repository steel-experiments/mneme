{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "./schema.json",
  "title": "Mneme eval fixture set",
  "description": "Synthetic, labeled evaluation episodes for the versioned prompt harness (Section 46.4). No production content.",
  "type": "object",
  "required": ["version", "promptVersions", "thresholds", "episodes"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "description": "Dataset schema version." },
    "description": { "type": "string" },
    "promptVersions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "thresholds": {
      "type": "object",
      "required": ["interventionConfidence", "minEvidenceStrength", "minPrecision"],
      "additionalProperties": false,
      "properties": {
        "interventionConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "minEvidenceStrength": { "type": "number", "minimum": 0, "maximum": 1 },
        "minPrecision": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "episodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/episode" }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "enum": ["silent", "memory_only", "review", "autonomous", "lifecycle_update", "visibility_refusal"]
    },
    "visibility": {
      "type": "string",
      "enum": ["org", "restricted", "review_only", "excluded"]
    },
    "mode": {
      "type": "string",
      "enum": ["observe", "review", "autonomous"]
    },
    "memory": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "supersededId": { "type": "string", "description": "Set when this memory supersedes an earlier one." }
      }
    },
    "notification": {
      "type": "object",
      "required": ["recommend", "confidence", "targetVisibility", "evidenceRestricted", "evidenceStrength", "evidenceMessageIds"],
      "additionalProperties": false,
      "properties": {
        "recommend": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "targetVisibility": { "$ref": "#/$defs/visibility" },
        "evidenceRestricted": { "type": "boolean" },
        "evidenceStrength": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceMessageIds": { "type": "array", "items": { "type": "string" } },
        "verdict": { "type": "string", "enum": ["approved", "dismissed"] },
        "dismissalReason": { "type": "string" }
      }
    },
    "response": {
      "type": "object",
      "required": ["memories", "notification", "costUsd", "responseLengthChars"],
      "additionalProperties": false,
      "properties": {
        "memories": { "type": "array", "items": { "$ref": "#/$defs/memory" } },
        "notification": { "oneOf": [{ "$ref": "#/$defs/notification" }, { "type": "null" }] },
        "duplicate": { "type": "boolean", "description": "True when the response duplicated an existing stored memory." },
        "costUsd": { "type": "number", "minimum": 0 },
        "responseLengthChars": { "type": "integer", "minimum": 0 }
      }
    },
    "episode": {
      "type": "object",
      "required": ["id", "label", "visibility", "mode", "conversationMessageCount", "responses"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "$ref": "#/$defs/label" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "mode": { "$ref": "#/$defs/mode" },
        "conversationMessageCount": { "type": "integer", "minimum": 0 },
        "duplicateMemory": { "type": "boolean", "description": "Dataset annotation that this scenario exercises memory dedup." },
        "responses": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/response" }
        }
      }
    }
  }
}
