# Mneme environment contract (Section 35) — complete reference.
# The basic install needs only the keys in .env.example. This file lists every
# supported setting with its default; copy single lines into .env as needed.
# No real secret belongs in this file or in YAML.
# Precedence: source security constraints > env > config/mneme.yml > defaults.
# Native runs load ./.env automatically; keys already set in the real
# environment keep their value. All changes take effect after a restart.

# ---- Required (Section 35.1) ----
# One platform for each deployment: discord or slack. There is no default.
MNEME_PLATFORM=discord

# Required when MNEME_PLATFORM=discord.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# Required when MNEME_PLATFORM=slack (spec Section 6.7). The bot token starts
# with xoxb-, the app-level token (Socket Mode, connections:write) with xapp-.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# The Slack workspace (team) id, for example TXXXXXXXXX.
# SLACK_TEAM_ID=
# Comma-separated Slack user ids allowed to run admin operations. Slack has no
# roles, so MNEME_ADMIN_ROLE_IDS must stay unset on Slack.
# MNEME_ADMIN_USER_IDS=

# Optional read-only archive of another platform's Mneme deployment (a verified
# backup file). Set both or neither. MNEME_ARCHIVE_PLATFORM must differ from
# MNEME_PLATFORM. The path is absolute, is not DATABASE_PATH, and is not in
# BACKUP_DIR.
# MNEME_ARCHIVE_PATH=/app/data/archive/discord.sqlite
# MNEME_ARCHIVE_PLATFORM=discord

# Defaults: openai and gpt-5.6-terra when unset. The value is still validated
# against the supported list when set.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra

# Set ONLY the key for the selected provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

ORG_NAME=Your Company
ORG_TIMEZONE=UTC

# ---- Channel policy ----
# basic builds the policy from the two selection lists below; CHANNEL_POLICY_PATH
# is not read. file loads CHANNEL_POLICY_PATH through the full policy format.
# The live reload command (/mneme reload-policy) applies to file mode only;
# basic mode needs a restart. Changes in either mode take effect after a restart.
CHANNEL_POLICY_SOURCE=basic
# Comma-separated channel or category ids to ingest as org-visible. Each
# Discord snowflake names exactly one resource kind; the matching entry
# applies. Slack has no categories: use Slack channel ids, and invite the bot
# to each channel. A Slack Connect channel is always excluded. Unselected
# channels are not ingested. At least one id must be present across
# the two lists; both empty is a startup error.
ORG_VISIBLE_CHANNEL_IDS=
# Comma-separated channel or category ids to ingest as restricted. An id must
# not appear in both lists.
RESTRICTED_CHANNEL_IDS=
# Must match review_channel.id in the channel policy when both are set.
MNEME_REVIEW_CHANNEL_ID=
# Set to true only after the review channel audience was verified; then the id
# above is required as well.
MNEME_REVIEW_CHANNEL_SECURE=false

# ---- Core application (Section 35.2) ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Storage and asset paths. Native runs resolve relative paths against the
# working directory; containers fix absolute /app values in docker-compose.yml,
# and those win over anything set here. Uncomment a line only to move off the
# default.
# DATA_DIR=./data
# DATABASE_PATH=./data/mneme.sqlite
# PROMPT_DIR=./prompts
# DOCS_DIR=./docs
# MNEME_CONFIG_PATH=./config/mneme.yml
# CHANNEL_POLICY_PATH=./config/channel-policy.yml
# Where backups are written. Defaults to $DATA_DIR/backups — /app/data/backups
# in containers, ./data/backups on native runs. Point this at a separately
# mounted volume for off-host storage (Section 42.1).
# BACKUP_DIR=./data/backups

# Optional canonical HTTPS base used for host-built documentation links.
DOCS_PUBLIC_URL=

# observe | review | autonomous. review/autonomous require a secure review channel.
MNEME_MODE=observe
MNEME_ADMIN_ROLE_IDS=
# User IDs allowed to approve another admin’s deletion request. Empty disables deletion.
MNEME_DELETION_APPROVER_USER_IDS=
HTTP_ADMIN_TOKEN=

# Optional release identity. Keep the source revision hexadecimal and exact;
# platforms such as Railway may provide their own trusted metadata instead.
MNEME_SOURCE_REVISION=
MNEME_BUILD_ID=

# ---- Ingestion (Section 35.3) ----
# FULL_HISTORY must be set explicitly. Choose the initial import scope:
# true  = import all reachable history for the selected channels;
# false = new messages onward (not a hard boundary; some sync paths may
#         still touch older rows).
FULL_HISTORY=
BACKFILL_CONCURRENCY=2
RECONCILE_INTERVAL_MINUTES=360
RECONCILE_OVERLAP_HOURS=24
RECONCILE_MAX_PAGES_PER_RUN=10
THREAD_DISCOVERY_INTERVAL_MINUTES=360
STORE_RAW_JSON=false

RETAIN_EDIT_HISTORY=false
RETAIN_DELETED_CONTENT=false

ATTACHMENT_MODE=metadata  # none | metadata | archive | selective
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MIME_ALLOWLIST=text/plain,text/markdown,application/json,text/csv,application/pdf

# ---- Episodes and agent (Section 35.4) ----
EPISODE_QUIET_SECONDS=90
EPISODE_MAX_MESSAGES=40
EPISODE_MAX_MINUTES=10
# Quiet seconds the conversation needs before its review runs (Section 11.8).
EPISODE_SETTLE_SECONDS=600
# Upper bound on holding one review for a busy conversation (Section 11.8).
EPISODE_SETTLE_MAX_MINUTES=60

AGENT_MAX_CONCURRENCY=1
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_RETRIEVED_CHARACTERS=60000
AGENT_THINKING_LEVEL=medium
EPISODE_SHADOW_ENABLED=false
EPISODE_SHADOW_MODEL=
EPISODE_SHADOW_THINKING_LEVEL=low
EPISODE_SHADOW_MAX_RUNS=50

INTERVENTION_THRESHOLD=0.78
MIN_EVIDENCE_STRENGTH=0.65
MIN_INTERVENTION_CONFIDENCE=0.65
CHANNEL_COOLDOWN_MINUTES=180
GLOBAL_AUTONOMOUS_POST_LIMIT_PER_DAY=5
MNEME_MAX_MESSAGE_CHARACTERS=1800
# A proactive trigger must be a human message created within this many days
# (Section 12.7). Positive integer; 0 is invalid.
INTERVENTION_ATTENTION_WINDOW_DAYS=7

DIRECT_ANSWER_ENABLED=true

# ---- Spend budgets ----
# Global admission control for all LLM spend per day, in USD. This is not a
# provider billing ceiling; the hosting bill is separate. Every feature —
# episodes, direct answers, deep recaps, historical campaigns — passes this
# gate first.
LLM_DAILY_BUDGET_USD=2

# Admin-requested durable reports for windows too large for one direct answer.
# Disabled by default. The two USD caps below are subordinate caps: they apply
# only while DEEP_RECAP_ENABLED=true, and they never raise the global budget
# above.
DEEP_RECAP_ENABLED=false
DEEP_RECAP_MAX_WINDOW_DAYS=30
DEEP_RECAP_MAX_BUDGET_USD=20
DEEP_RECAP_DAILY_BUDGET_USD=20

# Optional bounded historical-memory campaign. A campaign requires every field
# below plus an explicit org-channel allowlist. Its total cap survives restarts.
HISTORICAL_MEMORY_ENABLED=false
HISTORICAL_MEMORY_CHANNEL_IDS=
HISTORICAL_MEMORY_BATCH_MESSAGES=200
HISTORICAL_MEMORY_MAX_PENDING_REVIEWS=4
HISTORICAL_MEMORY_DAILY_BUDGET_USD=1
HISTORICAL_MEMORY_CAMPAIGN_ID=
HISTORICAL_MEMORY_DIRECTION=newest_first
HISTORICAL_MEMORY_FROM_AT=
HISTORICAL_MEMORY_TO_AT=
HISTORICAL_MEMORY_LLM_MODEL=
HISTORICAL_MEMORY_THINKING_LEVEL=medium
HISTORICAL_MEMORY_TOTAL_BUDGET_USD=

MEMORY_MINIMUM_CONFIDENCE=0.55
MEMORY_MINIMUM_IMPORTANCE=0.60
MEMORY_FOLLOWUP_HORIZON_DAYS=14
MEMORY_FOLLOWUP_MAX_MESSAGES=20
# Deprecated: parsed for compatibility, ignored by attention admission.
MEMORY_SCHEDULED_REVIEW_REMINDER_DAYS=7
# Deprecated: parsed for compatibility, ignored by attention admission.
MEMORY_STALENESS_HORIZON_DAYS=45
MEMORY_REQUIRE_EVIDENCE=true
MEMORY_REVIEW_PREDICTIONS=true
MEMORY_REVIEW_ASSUMPTIONS=true

# ---- Maintenance (Section 35.5) ----
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
# Terminal job rows (succeeded, failed, cancelled) older than this are pruned
# by the daily maintenance job. Queued and running rows are never pruned.
JOBS_RETENTION_DAYS=30
PRAGMA_OPTIMIZE_INTERVAL_HOURS=24
SHUTDOWN_TIMEOUT_SECONDS=30

# ---- MCP server (Section 35.6) — disabled unless external agent access is required ----
MCP_ENABLED=false
MCP_PATH=/mcp
# Public origin external clients reach; shown in the mcp-token create reply.
# Falls back to RAILWAY_PUBLIC_DOMAIN, then http://localhost:PORT.
MCP_PUBLIC_URL=
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_UNAUTH_RATE_LIMIT_PER_MINUTE=30
MCP_TOOL_LIST_TTL_MS=300000

# ---- Inspector web surface (Section 32.6) — read-only admin pages, off by default ----
INSPECTOR_ENABLED=false
INSPECTOR_PATH=/inspector
INSPECTOR_RATE_LIMIT_PER_MINUTE=120
INSPECTOR_UNAUTH_RATE_LIMIT_PER_MINUTE=30

# Optional OAuth sign-in with the active chat platform for remote MCP connectors.
MCP_OAUTH_ENABLED=false
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_REDIRECT_URIS=
# Discord deployments: the Discord application's OAuth client.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Slack deployments: the Slack app's client (Sign in with Slack).
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=

# ---- Optional provider knobs (Section 21.3) ----
TRIAGE_LLM_MODEL=
LLM_BASE_URL=
